//Agenda digital de contactos
using System;
using System.IO;

class Ejercicio6_AgendaContactos
{
    static string archivo = "contactos.csv";

    static void Main()
    {
        bool salir = false;
        while (!salir)
        {
            Console.WriteLine("\n--- Ejercicio 6: Agenda digital de contactos ---");
            Console.WriteLine("1. Agregar contacto");
            Console.WriteLine("2. Ver lista de contactos");
            Console.WriteLine("0. Salir");
            Console.Write("Seleccione una opción: ");
            string opcion = Console.ReadLine();

            switch (opcion)
            {
                case "1": AgregarContacto(); break;
                case "2": MostrarContactos(); break;
                case "0": salir = true; break;
                default: Console.WriteLine("Opción no válida."); break;
            }
        }
    }

    static void AgregarContacto()
    {
        Console.Write("\n¿Cuántos contactos desea agregar? ");
        if (!int.TryParse(Console.ReadLine(), out int cantidad) || cantidad <= 0)
        {
            Console.WriteLine("Cantidad inválida.");
            return;
        }

        using (StreamWriter sw = new StreamWriter(archivo, append: true))
        {
            for (int i = 0; i < cantidad; i++)
            {
                Console.WriteLine($"\nContacto {i + 1}:");

                Console.Write("  Nombre: ");
                string nombre = Console.ReadLine();
                if (string.IsNullOrWhiteSpace(nombre))
                {
                    Console.WriteLine("  Nombre vacío. Registro omitido.");
                    continue;
                }

                Console.Write("  Teléfono: ");
                string telefono = Console.ReadLine();
                if (string.IsNullOrWhiteSpace(telefono))
                {
                    Console.WriteLine("  Teléfono vacío. Registro omitido.");
                    continue;
                }

                Console.Write("  Correo electrónico: ");
                string correo = Console.ReadLine();
                if (string.IsNullOrWhiteSpace(correo))
                {
                    Console.WriteLine("  Correo vacío. Registro omitido.");
                    continue;
                }

                // Guardar en formato CSV: nombre,teléfono,correo
                sw.WriteLine($"{nombre},{telefono},{correo}");
                Console.WriteLine("  Contacto guardado.");
            }
        }
    }

    static void MostrarContactos()
    {
        if (!File.Exists(archivo))
        {
            Console.WriteLine("\nNo hay contactos disponibles.");
            return;
        }

        string[] lineas = File.ReadAllLines(archivo);

        if (lineas.Length == 0)
        {
            Console.WriteLine("\nLa agenda está vacía.");
            return;
        }

        Console.WriteLine($"\n{"Nombre",-25} {"Teléfono",-15} {"Correo",-30}");
        Console.WriteLine(new string('-', 72));

        foreach (string linea in lineas)
        {
            string[] campos = linea.Split(',');
            if (campos.Length != 3) continue;

            Console.WriteLine($"{campos[0],-25} {campos[1],-15} {campos[2],-30}");
        }
    }
}
