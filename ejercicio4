//Sistema de control de ventas
using System;
using System.IO;

class Ejercicio4_RegistroAcademico
{
    // Archivo CSV donde se guardan los registros
    static string archivo = "registro_academico.csv";

    static void Main()
    {
        bool salir = false;
        while (!salir)
        {
            Console.WriteLine("\n--- Ejercicio 4: Registro académico de estudiantes ---");
            Console.WriteLine("1. Agregar registro");
            Console.WriteLine("2. Ver reporte con promedios");
            Console.WriteLine("0. Salir");
            Console.Write("Seleccione una opción: ");
            string opcion = Console.ReadLine();

            switch (opcion)
            {
                case "1": AgregarRegistro(); break;
                case "2": MostrarReporte(); break;
                case "0": salir = true; break;
                default: Console.WriteLine("Opción no válida."); break;
            }
        }
    }

    static void AgregarRegistro()
    {
        Console.Write("\n¿Cuántos registros desea ingresar? ");
        if (!int.TryParse(Console.ReadLine(), out int cantidad) || cantidad <= 0)
        {
            Console.WriteLine("Cantidad inválida.");
            return;
        }

        // append: true → agrega al final del archivo sin borrar lo anterior
        using (StreamWriter sw = new StreamWriter(archivo, append: true))
        {
            for (int i = 0; i < cantidad; i++)
            {
                Console.WriteLine($"\nRegistro {i + 1}:");

                Console.Write("  Nombre del estudiante: ");
                string nombre = Console.ReadLine();
                if (string.IsNullOrWhiteSpace(nombre))
                {
                    Console.WriteLine("  Nombre vacío. Registro omitido.");
                    continue;
                }

                Console.Write("  Asignatura: ");
                string asignatura = Console.ReadLine();
                if (string.IsNullOrWhiteSpace(asignatura))
                {
                    Console.WriteLine("  Asignatura vacía. Registro omitido.");
                    continue;
                }

                Console.Write("  Calificación (0-100): ");
                if (!double.TryParse(Console.ReadLine(), out double calificacion) || calificacion < 0 || calificacion > 100)
                {
                    Console.WriteLine("  Calificación inválida. Registro omitido.");
                    continue;
                }

                // Guardar en formato CSV: nombre,asignatura,calificación
                sw.WriteLine($"{nombre},{asignatura},{calificacion}");
                Console.WriteLine("  Registro guardado.");
            }
        }
    }

    static void MostrarReporte()
    {
        if (!File.Exists(archivo))
        {
            Console.WriteLine("\nNo hay registros disponibles.");
            return;
        }

        // Leer todas las líneas del archivo de una vez
        string[] lineas = File.ReadAllLines(archivo);

        if (lineas.Length == 0)
        {
            Console.WriteLine("\nEl archivo está vacío.");
            return;
        }

        Console.WriteLine($"\n{"Nombre",-25} {"Asignatura",-20} {"Calificación",12}");
        Console.WriteLine(new string('-', 60));

        double sumaTotal = 0;
        int conteo = 0;

        foreach (string linea in lineas)
        {
            // Separar cada línea por coma para obtener los campos
            string[] campos = linea.Split(',');
            if (campos.Length != 3) continue;

            if (!double.TryParse(campos[2], out double cal)) continue;

            Console.WriteLine($"{campos[0],-25} {campos[1],-20} {cal,12:F2}");
            sumaTotal += cal;
            conteo++;
        }

        if (conteo > 0)
        {
            Console.WriteLine(new string('-', 60));
            Console.WriteLine($"Promedio general: {sumaTotal / conteo:F2}");
        }
    }
}
